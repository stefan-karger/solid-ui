{
  "name": "solid-ui",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Stefan E-K",
    "url": "https://twitter.com/stefan_e_k"
  },
  "type": "module",
  "scripts": {
    "astro:build": "node scripts/build-astro-solid.ts",
    "astro:check": "node scripts/build-astro-solid.ts --check",
    "build": "turbo run build",
    "build:cli": "turbo run build --filter=solidui-cli",
    "build:docs": "turbo run build --filter=docs",
    "changeset": "changeset",
    "check": "turbo run check",
    "dev": "turbo run dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "eslint . --cache --max-warnings 0",
    "lint:fix": "eslint . --cache --fix --max-warnings 0",
    "pub:beta": "pnpm --filter solidui-cli pub:beta",
    "pub:release": "pnpm --filter solidui-cli pub:release",
    "release": "changeset version",
    "test": "vitest run",
    "test:adapter": "pnpm build && pnpm --filter docs exec astro build --root test/fixtures/adapter && playwright test",
    "test:watch": "vitest",
    "validate": "pnpm astro:check && pnpm format:check && pnpm lint && pnpm check && pnpm test && pnpm build && pnpm test:adapter"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.3",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@solidjs/vite-plugin": "3.0.1",
    "@solidjs/web": "2.0.1",
    "@types/node": "24.19.2",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-solid": "0.20.1",
    "happy-dom": "21.0.4",
    "oxfmt": "0.80.0",
    "solid-js": "2.0.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.22.0 <25",
    "pnpm": "12.14.0"
  },
  "packageManager": "pnpm@12.14.0"
}
