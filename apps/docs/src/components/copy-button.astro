---
import type { HTMLAttributes } from "astro/types"

import { cn } from "~/lib/utils"

type Props = Omit<HTMLAttributes<"button">, "value"> & {
  value: string
}

const { value, class: className, ...props } = Astro.props
---

<button
  aria-label="Copy code"
  class={cn(
    "absolute top-3 right-2 z-10 flex size-7 items-center justify-center rounded-md bg-code text-code-foreground opacity-70 transition-[color,opacity,box-shadow] outline-none hover:bg-muted hover:opacity-100 focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50",
    className
  )}
  data-copy-button
  data-copy-value={value}
  data-slot="copy-button"
  type="button"
  {...props}
>
  <svg
    aria-hidden="true"
    class="size-4"
    data-copy-icon
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
  </svg>
  <svg
    aria-hidden="true"
    class="hidden size-4"
    data-check-icon
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M20 6 9 17l-5-5"></path>
  </svg>
  <span aria-live="polite" class="sr-only" data-copy-status></span>
</button>
