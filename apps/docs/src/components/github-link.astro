---
import { getRepositoryStars, repositoryUrl } from "~/lib/site"
import { buttonVariants } from "~/registry/ui/button"

const stars = await getRepositoryStars()
const count =
  stars === undefined
    ? undefined
    : stars >= 1000
      ? `${Math.round(stars / 1000)}k`
      : stars.toLocaleString("en-US")
---

<a
  href={repositoryUrl}
  target="_blank"
  rel="noreferrer"
  aria-label={
    stars === undefined
      ? "Solid UI on GitHub"
      : `Solid UI on GitHub, ${stars.toLocaleString("en-US")} stars`
  }
  class:list={[
    buttonVariants({ variant: "ghost", size: "sm" }),
    "extend-touch-target h-8 gap-1.5 border-0 px-2.5 shadow-none max-sm:hidden"
  ]}
>
  <svg
    viewBox="0.75 0.75 22.5 22.5"
    fill="currentColor"
    class="size-4"
    aria-hidden="true"
  >
    <path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.09c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.68.08-.68 1.13.08 1.73 1.16 1.73 1.16 1 1.72 2.64 1.22 3.28.93.1-.73.39-1.22.71-1.5-2.5-.29-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15a10.77 10.77 0 0 1 5.64 0c2.15-1.46 3.1-1.15 3.1-1.15.61 1.55.23 2.7.11 2.98.72.79 1.16 1.79 1.16 3.02 0 4.32-2.63 5.27-5.14 5.55.4.35.76 1.03.76 2.08v3.09c0 .3.21.65.78.54A11.25 11.25 0 0 0 12 .75Z"></path>
  </svg>
  {count !== undefined && (
    <span class="text-xs text-muted-foreground tabular-nums" data-github-stars>
      {count}
    </span>
  )}
</a>
