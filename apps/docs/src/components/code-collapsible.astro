---
import type { HTMLAttributes } from "astro/types"

import { cn } from "~/lib/utils"

type Props = HTMLAttributes<"div"> & {
  variant: "preview" | "source"
}

const { variant, class: className, ...props } = Astro.props
const isPreview = variant === "preview"
---

<div
  class={cn(
    "group/code-collapsible relative block",
    isPreview
      ? "[&_pre]:max-h-72"
      : "mt-6 overflow-hidden rounded-2xl bg-code md:-mx-1 [&_[data-rehype-pretty-code-figure]]:m-0! [&_pre]:max-h-96",
    className
  )}
  data-code-collapsible
  data-variant={variant}
  {...props}
>
  <div data-code-content>
    <slot />
  </div>

  {!isPreview && (
    <div class="absolute top-1.5 right-9 z-20 items-center" data-code-control data-code-top-control>
      <button
        class="inline-flex h-7 items-center rounded-md px-2 text-sm text-muted-foreground transition-colors outline-none hover:bg-muted hover:text-foreground focus-visible:ring-[3px] focus-visible:ring-ring/50"
        data-code-toggle
        type="button"
      >
        <span data-code-label-collapsed>Expand</span>
        <span data-code-label-expanded hidden>
          Collapse
        </span>
      </button>
      <span aria-hidden="true" class="mx-1.5 h-4 w-px bg-border" />
    </div>
  )}

  <div
    class={cn(
      "absolute inset-x-0 bottom-0 z-10 items-center justify-center",
      isPreview ? "top-0 pb-4" : "h-20"
    )}
    data-code-control
    data-code-reveal
  >
    <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-code via-code/60 to-transparent"></div>
    <button
      class={cn(
        "relative z-10 inline-flex items-center justify-center text-sm font-medium transition-colors outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50",
        isPreview
          ? "h-8 rounded-lg border border-input bg-background px-3 text-foreground hover:bg-muted"
          : "h-8 rounded-md px-3 text-muted-foreground hover:text-foreground"
      )}
      data-code-toggle
      type="button"
    >
      <span data-code-label-collapsed>{isPreview ? "View Code" : "Expand"}</span>
      <span data-code-label-expanded hidden>
        Collapse
      </span>
    </button>
  </div>
</div>
