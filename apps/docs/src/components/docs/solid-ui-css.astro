---
import { createSolidUiCss, solidUiCssPackages } from "@solid-ui/registry/css"
import { DEFAULT_PRESET_NAME, DEFAULT_PRESETS } from "@solid-ui/registry/preset"

import CodeBlockCommand from "~/components/code-block-command.astro"
import CodeCollapsible from "~/components/code-collapsible.astro"
import ComponentCode from "~/components/component-code.astro"
import { highlightCode } from "~/lib/highlight-code"
import { getRegistrySource } from "~/lib/registry.server"

// The stylesheet init writes for the default preset, built by the same
// function, without the "generated by solidui-cli" header.
const { preset } = DEFAULT_PRESETS[DEFAULT_PRESET_NAME]
const utilities = await getRegistrySource({ name: "style-utilities" })
const css = createSolidUiCss({
  preset,
  utilitiesCss: utilities.code,
  appCss: "App.css"
}).replace(/^\/\*[\s\S]*?\*\/\s*/, "")
const packages = solidUiCssPackages(preset).join(" ")
const highlightedCode = await highlightCode(css, "css")
---

<figure data-rehype-pretty-code-figure>
  <CodeBlockCommand
    npm={`npm install ${packages}`}
    pnpm={`pnpm add ${packages}`}
    yarn={`yarn add ${packages}`}
    bun={`bun add ${packages}`}
  />
</figure>

<CodeCollapsible variant="source">
  <ComponentCode
    code={css}
    highlightedCode={highlightedCode}
    language="css"
    title="src/solid-ui.css"
    class="m-0! md:mx-0!"
  />
</CodeCollapsible>
