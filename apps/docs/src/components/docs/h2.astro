---
import type { HTMLAttributes } from "astro/types"

import { createHeadingId } from "~/lib/heading-ids"
import { cn } from "~/lib/utils"

type Props = HTMLAttributes<"h2">

const { class: className, id, ...props } = Astro.props
const slotContent = Astro.slots.has("default")
  ? await Astro.slots.render("default")
  : ""
const headingId =
  id === undefined ? createHeadingId(slotContent) || undefined : id
---

<h2
  id={headingId}
  class={cn(
    "mt-10 scroll-m-28 font-heading text-[1.25em]/[1.4] font-semibold first:mt-0 lg:mt-12 [&_code]:text-[0.9em] [&+.steps]:mt-0! [&+.steps>h3]:mt-4! [&+h3]:mt-6! [&+p]:mt-4!",
    className
  )}
  {...props}
>
  {headingId ? (
    <a
      class="group/heading inline-flex items-baseline gap-2 no-underline outline-none"
      href={`#${headingId}`}
    >
      <Fragment set:html={slotContent} />
      <span
        aria-hidden="true"
        class="text-muted-foreground opacity-0 transition-opacity group-focus-within/heading:opacity-100 group-hover/heading:opacity-100"
      >
        #
      </span>
    </a>
  ) : (
    <Fragment set:html={slotContent} />
  )}
</h2>
