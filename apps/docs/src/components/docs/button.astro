---
import type { HTMLAttributes } from "astro/types"

import { cn } from "~/lib/utils"

type Variant = "default" | "outline" | "secondary" | "ghost" | "destructive" | "link"
type Size = "default" | "xs" | "sm" | "lg" | "icon" | "icon-xs" | "icon-sm" | "icon-lg"
type Props = (HTMLAttributes<"a"> | HTMLAttributes<"button">) & {
  href?: string
  variant?: Variant
  size?: Size
}

// React's `asChild` API is intentionally unsupported. In MDX, migrate link CTAs to `href`.
const { class: className, href, variant = "default", size = "default", ...props } = Astro.props

const classes = cn(
  "group/button cn-button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0",
  `cn-button-variant-${variant}`,
  `cn-button-size-${size}`,
  className
)
---

{
  href ? (
    <a class={classes} data-not-typeset data-slot="button" href={href} {...props}>
      <slot />
    </a>
  ) : (
    <button {...props} class={classes} data-not-typeset data-slot="button" type="button">
      <slot />
    </button>
  )
}
