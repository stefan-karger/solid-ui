---
import type { HTMLAttributes } from "astro/types"

import { cn } from "~/lib/utils"

type Props = HTMLAttributes<"img"> & {
  alt: string
}

const { class: className, loading = "lazy", decoding = "async", ...props } = Astro.props
---

<img
  class={cn("mt-6 block h-auto max-w-full rounded-md border", className)}
  loading={loading}
  decoding={decoding}
  {...props}
/>
