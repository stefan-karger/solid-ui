---
import type { HTMLAttributes } from "astro/types"

import { cn } from "~/lib/utils"

type Props = HTMLAttributes<"div"> & {
  title?: string
  showIcon?: boolean
  variant?: "default" | "info" | "warning"
}

const { class: className, title, showIcon = false, variant = "default", ...props } = Astro.props

const hasIconSlot = Astro.slots.has("icon")
const hasIcon = hasIconSlot || showIcon
---

<div
  class={cn(
    "mt-6 grid w-auto min-w-0 items-start gap-y-1 rounded-xl border border-surface bg-surface px-4 py-3 text-sm text-surface-foreground [&_code]:border",
    hasIcon ? "grid-cols-[auto_minmax(0,1fr)]" : "grid-cols-1",
    className
  )}
  data-variant={variant}
  {...props}
>
  {hasIcon && (
    <div
      class={cn(
        "col-start-1 mr-3 text-current [&_svg]:size-4 [&_svg]:translate-y-0.5",
        title ? "row-span-2" : "row-span-1"
      )}
    >
      {hasIconSlot ? (
        <slot name="icon" />
      ) : variant === "warning" ? (
        <svg
          aria-hidden="true"
          fill="none"
          focusable="false"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path d="m21.73 18-8-14a2 2 0 0 0-3.46 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
          <path d="M12 9v4" />
          <path d="M12 17h.01" />
        </svg>
      ) : (
        <svg
          aria-hidden="true"
          fill="none"
          focusable="false"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <circle cx="12" cy="12" r="10" />
          <path d="M12 16v-4" />
          <path d="M12 8h.01" />
        </svg>
      )}
    </div>
  )}

  {title && (
    <div
      class={cn("col-start-1 min-h-4 min-w-0 font-medium tracking-tight", hasIcon && "col-start-2")}
    >
      {title}
    </div>
  )}

  <div
    class={cn(
      "col-start-1 grid min-w-0 gap-1 text-sm break-words text-card-foreground/80 [&_p]:leading-relaxed",
      hasIcon && "col-start-2"
    )}
  >
    <slot />
  </div>
</div>
