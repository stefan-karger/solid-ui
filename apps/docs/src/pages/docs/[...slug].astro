---
import { getCollection, render, type CollectionEntry } from "astro:content"

import { mdxComponents } from "~/components/mdx-components"
import DocsLayout from "~/layouts/docs-layout.astro"
import { getComponentNeighbors, toDocsPath, toRouteId } from "~/lib/docs"

export async function getStaticPaths() {
  const pages = await getCollection("docs")

  return pages.map((page) => ({
    params: { slug: toRouteId(page.id) || undefined },
    props: { page }
  }))
}

type Props = {
  page: CollectionEntry<"docs">
}

const { page } = Astro.props
const { Content, headings } = await render(page)
const componentNeighbors = page.data.component
  ? await getComponentNeighbors(page.id, () => getCollection("docs"))
  : { previous: null, next: null }
---

<DocsLayout title={page.data.title} headings={headings}>
  <article
    aria-label="MDX component examples"
    class="mx-auto w-full max-w-3xl px-4 py-7 font-sans sm:px-6 sm:py-9 [&_[data-rehype-pretty-code-figure]:first-child]:mt-0"
    data-slot="docs"
  >
    <header class="mb-8 flex flex-col gap-2">
      <h1 class="scroll-m-28 font-heading text-3xl font-bold tracking-tight">{page.data.title}</h1>
      <p class="text-[1.05rem] text-muted-foreground sm:text-base sm:text-balance">
        {page.data.description}
      </p>
    </header>

    <div class="w-full *:first:mt-0">
      <Content components={mdxComponents} />
    </div>

    {page.data.component && (componentNeighbors.previous || componentNeighbors.next) && (
      <footer class="mt-16 flex w-full items-center gap-2 border-t pt-6">
        {componentNeighbors.previous && (
          <a
            aria-label={`Previous component: ${componentNeighbors.previous.data.title}`}
            class="inline-flex h-9 items-center justify-center rounded-md border border-input bg-background px-3 text-sm font-medium transition-colors outline-none hover:bg-accent hover:text-accent-foreground focus-visible:ring-2 focus-visible:ring-ring"
            href={toDocsPath(componentNeighbors.previous.id)}
          >
            <span aria-hidden="true">←</span>
            <span class="ml-2">{componentNeighbors.previous.data.title}</span>
          </a>
        )}

        {componentNeighbors.next && (
          <a
            aria-label={`Next component: ${componentNeighbors.next.data.title}`}
            class="ml-auto inline-flex h-9 items-center justify-center rounded-md border border-input bg-background px-3 text-sm font-medium transition-colors outline-none hover:bg-accent hover:text-accent-foreground focus-visible:ring-2 focus-visible:ring-ring"
            href={toDocsPath(componentNeighbors.next.id)}
          >
            <span class="mr-2">{componentNeighbors.next.data.title}</span>
            <span aria-hidden="true">→</span>
          </a>
        )}
      </footer>
    )}
  </article>
</DocsLayout>
