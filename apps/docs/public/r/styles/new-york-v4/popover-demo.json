{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "popover-demo",
  "type": "registry:example",
  "registryDependencies": [
    "popover",
    "button",
    "input",
    "label"
  ],
  "files": [
    {
      "path": "src/registry/new-york-v4/examples/popover-demo.tsx",
      "content": "import { Button } from \"~/registry/new-york-v4/ui/button\"\r\nimport { Input } from \"~/registry/new-york-v4/ui/input\"\r\nimport { Label } from \"~/registry/new-york-v4/ui/label\"\r\nimport { Popover, PopoverContent, PopoverTrigger } from \"~/registry/new-york-v4/ui/popover\"\r\n\r\nexport default function PopoverDemo() {\r\n  return (\r\n    <Popover>\r\n      <Button as={PopoverTrigger} variant=\"outline\">\r\n        Open popover\r\n      </Button>\r\n\r\n      <PopoverContent class=\"w-80\">\r\n        <div class=\"grid gap-4\">\r\n          <div class=\"space-y-2\">\r\n            <h4 class=\"font-medium leading-none\">Dimensions</h4>\r\n            <p class=\"text-muted-foreground text-sm\">Set the dimensions for the layer.</p>\r\n          </div>\r\n          <div class=\"grid gap-2\">\r\n            <div class=\"grid grid-cols-3 items-center gap-4\">\r\n              <Label for=\"width\">Width</Label>\r\n              <Input class=\"col-span-2 h-8\" id=\"width\" value=\"100%\" />\r\n            </div>\r\n            <div class=\"grid grid-cols-3 items-center gap-4\">\r\n              <Label for=\"maxWidth\">Max. width</Label>\r\n              <Input class=\"col-span-2 h-8\" id=\"maxWidth\" value=\"300px\" />\r\n            </div>\r\n            <div class=\"grid grid-cols-3 items-center gap-4\">\r\n              <Label for=\"height\">Height</Label>\r\n              <Input class=\"col-span-2 h-8\" id=\"height\" value=\"25px\" />\r\n            </div>\r\n            <div class=\"grid grid-cols-3 items-center gap-4\">\r\n              <Label for=\"maxHeight\">Max. height</Label>\r\n              <Input class=\"col-span-2 h-8\" id=\"maxHeight\" value=\"none\" />\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </PopoverContent>\r\n    </Popover>\r\n  )\r\n}\r\n",
      "type": "registry:example"
    }
  ]
}