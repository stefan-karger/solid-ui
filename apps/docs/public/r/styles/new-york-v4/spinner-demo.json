{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "spinner-demo",
  "type": "registry:example",
  "registryDependencies": [
    "spinner",
    "item"
  ],
  "files": [
    {
      "path": "src/registry/new-york-v4/examples/spinner-demo.tsx",
      "content": "import { Item, ItemContent, ItemMedia, ItemTitle } from \"~/registry/new-york-v4/ui/item\"\r\nimport { Spinner } from \"~/registry/new-york-v4/ui/spinner\"\r\n\r\nexport default function SpinnerDemo() {\r\n  return (\r\n    <div class=\"flex w-full max-w-xs flex-col gap-4 [--radius:1rem]\">\r\n      <Item variant=\"muted\">\r\n        <ItemMedia>\r\n          <Spinner />\r\n        </ItemMedia>\r\n        <ItemContent>\r\n          <ItemTitle class=\"line-clamp-1\">Processing payment...</ItemTitle>\r\n        </ItemContent>\r\n        <ItemContent class=\"flex-none justify-end\">\r\n          <span class=\"text-sm tabular-nums\">$100.00</span>\r\n        </ItemContent>\r\n      </Item>\r\n    </div>\r\n  )\r\n}\r\n",
      "type": "registry:example"
    }
  ]
}