{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "item-demo",
  "type": "registry:example",
  "registryDependencies": [
    "item",
    "button"
  ],
  "files": [
    {
      "path": "src/registry/v1/examples/item-demo.tsx",
      "content": "import { IconBadgeCheck, IconChevronRight } from \"~/components/icons\"\r\nimport { Button } from \"~/registry/v1/ui/button\"\r\nimport {\r\n  Item,\r\n  ItemActions,\r\n  ItemContent,\r\n  ItemDescription,\r\n  ItemMedia,\r\n  ItemTitle\r\n} from \"~/registry/v1/ui/item\"\r\n\r\nexport default function ItemDemo() {\r\n  return (\r\n    <div class=\"flex w-full max-w-md flex-col gap-6\">\r\n      <Item variant=\"outline\">\r\n        <ItemContent>\r\n          <ItemTitle>Basic Item</ItemTitle>\r\n          <ItemDescription>A simple item with title and description.</ItemDescription>\r\n        </ItemContent>\r\n        <ItemActions>\r\n          <Button size=\"sm\" variant=\"outline\">\r\n            Action\r\n          </Button>\r\n        </ItemActions>\r\n      </Item>\r\n      <Item as=\"a\" href=\"#\" size=\"sm\" variant=\"outline\">\r\n        <ItemMedia>\r\n          <IconBadgeCheck class=\"size-5\" />\r\n        </ItemMedia>\r\n        <ItemContent>\r\n          <ItemTitle>Your profile has been verified.</ItemTitle>\r\n        </ItemContent>\r\n        <ItemActions>\r\n          <IconChevronRight class=\"size-4\" />\r\n        </ItemActions>\r\n      </Item>\r\n    </div>\r\n  )\r\n}\r\n",
      "type": "registry:example"
    }
  ]
}