  "files": [
    {
      "path": "src/registry/v1/examples/breadcrumb-demo.tsx",
      "content": "import {\r\n  Breadcrumb,\r\n  BreadcrumbEllipsis,\r\n  BreadcrumbItem,\r\n  BreadcrumbLink,\r\n  BreadcrumbList,\r\n  BreadcrumbPage,\r\n  BreadcrumbSeparator\r\n} from \"~/registry/v1/ui/breadcrumb\"\r\nimport {\r\n  DropdownMenu,\r\n  DropdownMenuContent,\r\n  DropdownMenuItem,\r\n  DropdownMenuTrigger\r\n} from \"~/registry/v1/ui/dropdown-menu\"\r\n\r\nexport default function BreadcrumbDemo() {\r\n  return (\r\n    <Breadcrumb>\r\n      <BreadcrumbList>\r\n        <BreadcrumbItem>\r\n          <BreadcrumbLink href=\"/\">Home</BreadcrumbLink>\r\n        </BreadcrumbItem>\r\n        <BreadcrumbSeparator />\r\n        <BreadcrumbItem>\r\n          <DropdownMenu>\r\n            <DropdownMenuTrigger class=\"flex items-center gap-1\">\r\n              <BreadcrumbEllipsis class=\"size-4\" />\r\n              <span class=\"sr-only\">Toggle menu</span>\r\n            </DropdownMenuTrigger>\r\n            <DropdownMenuContent>\r\n              <DropdownMenuItem>Documentation</DropdownMenuItem>\r\n              <DropdownMenuItem>Themes</DropdownMenuItem>\r\n              <DropdownMenuItem>GitHub</DropdownMenuItem>\r\n            </DropdownMenuContent>\r\n          </DropdownMenu>\r\n        </BreadcrumbItem>\r\n        <BreadcrumbSeparator />\r\n        <BreadcrumbItem>\r\n          <BreadcrumbLink href=\"/docs/components\">Components</BreadcrumbLink>\r\n        </BreadcrumbItem>\r\n        <BreadcrumbSeparator />\r\n        <BreadcrumbItem>\r\n          <BreadcrumbPage>Breadcrumb</BreadcrumbPage>\r\n        </BreadcrumbItem>\r\n      </BreadcrumbList>\r\n    </Breadcrumb>\r\n  )\r\n}\r\n",
      "type": "registry:example"
    }
  ]
}