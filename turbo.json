{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "public/r/**", "public/registry/**"]
    },
    "check": {
      "dependsOn": ["^check"],
      "outputs": []
    }
  }
}
